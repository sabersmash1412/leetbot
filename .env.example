# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=

# Shared secret required as ?key=... on all /cron/* endpoints
CRON_SECRET=

# Express listen port (Render/Railway inject this automatically)
PORT=3000

# Public HTTPS base URL of this deployment, used to register the Telegram webhook
# e.g. https://leetbot.onrender.com  (Render also auto-injects RENDER_EXTERNAL_URL as a fallback)
PUBLIC_URL=

# Random path segment for the webhook route, e.g. tg-7f3a9c2e (keeps random scanners from POSTing fake updates)
WEBHOOK_SECRET_PATH=

# Informational only — cosmetic date/time formatting. Scheduling itself is controlled by your external cron pinger.
TZ=UTC

NODE_ENV=development
LOG_LEVEL=info
